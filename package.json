{
  "name": "auralisstreamer",
  "version": "0.1.0",
  "private": true,
  "description": "Auralis Streamer — private audio sessions, desktop alpha",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build:ui": "tsc --noEmit && vite build",
    "build:native": "cargo build --release --manifest-path native/Cargo.toml",
    "build": "npm run build:ui && npm run build:native",
    "package": "npm run build && node scripts/package.mjs",
    "start": "electron .",
    "test": "cargo test --manifest-path native/Cargo.toml && cargo build --manifest-path native/Cargo.toml && node --test tests/*.test.cjs",
    "check": "tsc --noEmit && cargo fmt --manifest-path native/Cargo.toml -- --check",
    "test:app": "node tests/smoke.mjs",
    "icon": "electron scripts/icon.cjs"
  },
  "dependencies": {
    "lucide-react": "^1.62.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@electron/packager": "^20.3.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "electron": "^45.0.0",
    "playwright": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "type": "module"
}
